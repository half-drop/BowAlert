{
  "schemaVersion": 1,
  "id": "bowalert",
  "version": "${version}",
  "name": "Bow Alert",
  "description": "Warns you when nearby entities holding ranged or throwable weapons are facing your direction.",
  "authors": ["half_drop"],
  "contact": {
    "sources": "https://github.com/half-drop/BowAlert"
  },
  "license": "MIT",
  "icon": "assets/bowalert/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.halfdrop.bowalert.BowAlertClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
